<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Agency HR Management</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        navy: {
                            50: '#f0f4f8',
                            100: '#d9e2ec',
                            500: '#334e68',
                            800: '#102a43',
                            900: '#0b1f33',
                        },
                        teal: {
                            500: '#14b8a6',
                            600: '#0d9488',
                        }
                    },
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                    }
                }
            }
        }
    </script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <script crossorigin src="https://unpkg.com/react@18/umd/react.development.js"></script>
    <script crossorigin src="https://unpkg.com/react-dom@18/umd/react-dom.development.js"></script>
    <script src="https://unpkg.com/@babel/standalone/babel.min.js"></script>
    <style>
        body { background-color: #f4f7f6; }
        .glass-panel {
            background: rgba(255, 255, 255, 0.95);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255, 255, 255, 0.2);
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05), 0 2px 4px -1px rgba(0, 0, 0, 0.03);
        }
        .animate-fade-in { animation: fadeIn 0.3s ease-in-out; }
        @keyframes fadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }
        ::-webkit-scrollbar { width: 6px; height: 6px; }
        ::-webkit-scrollbar-track { background: transparent; }
        ::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 3px; }
        ::-webkit-scrollbar-thumb:hover { background: #94a3b8; }
    </style>
</head>
<body class="text-slate-800 antialiased">
    <div id="root"></div>

    <script type="text/babel">
        const { useState, useEffect, useMemo } = React;

        // --- ICONS (Lucide/Heroicons equivalents) ---
        const IconUsers = ({className="w-5 h-5"}) => <svg className={className} fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z" /></svg>;
        const IconDashboard = ({className="w-5 h-5"}) => <svg className={className} fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z" /></svg>;
        const IconMoney = ({className="w-5 h-5"}) => <svg className={className} fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>;
        const IconStar = ({className="w-5 h-5"}) => <svg className={className} fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z" /></svg>;
        const IconPlus = ({className="w-5 h-5"}) => <svg className={className} fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M12 6v6m0 0v6m0-6h6m-6 0H6" /></svg>;
        const IconSearch = ({className="w-5 h-5"}) => <svg className={className} fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" /></svg>;
        const IconEdit = ({className="w-4 h-4"}) => <svg className={className} fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z" /></svg>;
        const IconClose = ({className="w-5 h-5"}) => <svg className={className} fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M6 18L18 6M6 6l12 12" /></svg>;

        // --- OOP DOMAIN LOGIC ---
        class Employee {
            constructor(id, name, type, baseSalary) {
                this.id = id;
                this.name = name;
                this.type = type; // 'office', 'production', 'manager'
                this.baseSalary = Number(baseSalary);
            }
            calculateSalary() { return 0; }
            getTypeLabel() {
                const labels = { office: 'NV Văn phòng', production: 'NV Sản xuất', manager: 'NV Quản lý' };
                return labels[this.type] || 'Không xác định';
            }
        }

        class OfficeEmployee extends Employee {
            constructor(id, name, baseSalary, hours) {
                super(id, name, 'office', baseSalary);
                this.hours = Number(hours);
            }
            calculateSalary() {
                const allowance = this.hours > 100 ? 5000000 : 0;
                return this.baseSalary + (this.hours * 220000) + allowance;
            }
        }

        class ProductionEmployee extends Employee {
            constructor(id, name, baseSalary, products) {
                super(id, name, 'production', baseSalary);
                this.products = Number(products);
            }
            calculateSalary() {
                let total = this.baseSalary + (this.products * 175000);
                if (this.products > 150) {
                    total = total * 1.2; // 20% bonus
                }
                return total;
            }
        }

        class ManagerEmployee extends Employee {
            constructor(id, name, baseSalary, roleFactor, bonus) {
                super(id, name, 'manager', baseSalary);
                this.roleFactor = Number(roleFactor);
                this.bonus = Number(bonus);
            }
            calculateSalary() {
                return (this.baseSalary * this.roleFactor) + this.bonus;
            }
        }

        const createEmployeeObj = (data) => {
            switch(data.type) {
                case 'office': return new OfficeEmployee(data.id, data.name, data.baseSalary, data.hours);
                case 'production': return new ProductionEmployee(data.id, data.name, data.baseSalary, data.products);
                case 'manager': return new ManagerEmployee(data.id, data.name, data.baseSalary, data.roleFactor, data.bonus);
                default: return new Employee(data.id, data.name, data.type, data.baseSalary);
            }
        };

        const formatVND = (amount) => {
            return new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' }).format(amount);
        };

        // --- COMPONENTS ---
        const Sidebar = () => (
            <div className="w-64 bg-navy-900 text-white min-h-screen flex flex-col hidden md:flex sticky top-0 h-screen shadow-xl z-10">
                <div className="p-6">
                    <h1 className="text-2xl font-bold tracking-tight text-white flex items-center gap-2">
                        <div className="w-8 h-8 bg-teal-500 rounded-lg flex items-center justify-center shadow-sm">
                            <span className="text-white font-black text-lg">H</span>
                        </div>
                        AgencyHR
                    </h1>
                </div>
                <nav className="flex-1 px-4 mt-6 space-y-2">
                    <a href="#" className="flex items-center gap-3 px-4 py-3 bg-teal-600/20 text-teal-400 rounded-xl transition-colors border border-teal-500/20">
                        <IconUsers />
                        <span className="font-medium">Nhân sự</span>
                    </a>
                    <a href="#" className="flex items-center gap-3 px-4 py-3 text-slate-400 hover:bg-white/5 hover:text-white rounded-xl transition-colors">
                        <IconDashboard />
                        <span className="font-medium">Tổng quan</span>
                    </a>
                </nav>
                <div className="p-4 border-t border-white/10 bg-navy-800/50">
                    <div className="flex items-center gap-3 px-4 py-2">
                        <div className="w-10 h-10 rounded-full bg-slate-700 overflow-hidden ring-2 ring-teal-500/30">
                            <img src="https://ui-avatars.com/api/?name=Admin&background=0D8ABC&color=fff" alt="Admin" className="w-full h-full object-cover"/>
                        </div>
                        <div>
                            <p className="text-sm font-medium">Administrator</p>
                            <p className="text-xs text-slate-400">admin@agency.com</p>
                        </div>
                    </div>
                </div>
            </div>
        );

        const StatCard = ({ title, value, icon, subtext, colorClass }) => (
            <div className="glass-panel rounded-2xl p-6 flex items-start gap-4 hover:shadow-lg transition-all duration-300 transform hover:-translate-y-1">
                <div className={`p-4 rounded-xl shadow-inner ${colorClass}`}>
                    {icon}
                </div>
                <div>
                    <p className="text-sm font-medium text-slate-500 mb-1">{title}</p>
                    <h3 className="text-2xl font-bold text-slate-800 tracking-tight">{value}</h3>
                    {subtext && <p className="text-xs font-medium text-slate-400 mt-2 bg-slate-100 inline-block px-2 py-1 rounded-md">{subtext}</p>}
                </div>
            </div>
        );

        // --- MAIN APP ---
        const App = () => {
            const [employees, setEmployees] = useState([]);
            const [search, setSearch] = useState('');
            const [isAddOpen, setIsAddOpen] = useState(false);
            const [updateModal, setUpdateModal] = useState({ isOpen: false, emp: null });

            useEffect(() => {
                const stored = localStorage.getItem('agency_hr_data');
                if (stored) {
                    const parsed = JSON.parse(stored);
                    setEmployees(parsed.map(createEmployeeObj));
                } else {
                    const initData = [
                        createEmployeeObj({ id: 'NV001', name: 'Nguyễn Văn A', type: 'office', baseSalary: 8000000, hours: 120 }),
                        createEmployeeObj({ id: 'NV002', name: 'Trần Thị B', type: 'production', baseSalary: 6000000, products: 180 }),
                        createEmployeeObj({ id: 'NV003', name: 'Lê Hoàng C', type: 'manager', baseSalary: 15000000, roleFactor: 1.5, bonus: 5000000 }),
                    ];
                    setEmployees(initData);
                    localStorage.setItem('agency_hr_data', JSON.stringify(initData));
                }
            }, []);

            const saveState = (newData) => {
                setEmployees(newData);
                localStorage.setItem('agency_hr_data', JSON.stringify(newData));
            };

            const filteredEmployees = useMemo(() => {
                if(!search) return employees;
                const lowerSearch = search.toLowerCase();
                return employees.filter(e => 
                    e.id.toLowerCase().includes(lowerSearch) || 
                    e.name.toLowerCase().includes(lowerSearch)
                );
            }, [employees, search]);

            const totalEmployees = employees.length;
            const avgSalary = totalEmployees > 0 
                ? employees.reduce((sum, e) => sum + e.calculateSalary(), 0) / totalEmployees 
                : 0;
            
            let highestBase = null;
            if (employees.length > 0) {
                highestBase = employees.reduce((prev, current) => (prev.baseSalary > current.baseSalary) ? prev : current);
            }

            const [addForm, setAddForm] = useState({ type: 'office', id: '', name: '', baseSalary: '' });
            const [extraFields, setExtraFields] = useState({ hours: '', products: '', roleFactor: '', bonus: '' });

            const handleAddSubmit = (e) => {
                e.preventDefault();
                const newEmpData = {
                    id: addForm.id,
                    name: addForm.name,
                    type: addForm.type,
                    baseSalary: Number(addForm.baseSalary),
                    hours: Number(extraFields.hours || 0),
                    products: Number(extraFields.products || 0),
                    roleFactor: Number(extraFields.roleFactor || 1),
                    bonus: Number(extraFields.bonus || 0)
                };
                const newEmp = createEmployeeObj(newEmpData);
                saveState([...employees, newEmp]);
                setIsAddOpen(false);
                setAddForm({ type: 'office', id: '', name: '', baseSalary: '' });
                setExtraFields({ hours: '', products: '', roleFactor: '', bonus: '' });
            };

            const [updateSalaryVal, setUpdateSalaryVal] = useState('');
            const handleUpdateSalarySubmit = (e) => {
                e.preventDefault();
                if(!updateModal.emp) return;
                const updated = employees.map(emp => {
                    if (emp.id === updateModal.emp.id) {
                        return createEmployeeObj({ ...emp, baseSalary: Number(updateSalaryVal) });
                    }
                    return emp;
                });
                saveState(updated);
                setUpdateModal({ isOpen: false, emp: null });
            };

            return (
                <div className="flex min-h-screen">
                    <Sidebar />
                    
                    <main className="flex-1 p-6 md:p-10 max-w-7xl mx-auto w-full relative z-0">
                        <header className="flex flex-col md:flex-row md:items-center justify-between mb-10 gap-4">
                            <div>
                                <h2 className="text-3xl font-bold text-slate-800 tracking-tight">Quản lý Nhân sự</h2>
                                <p className="text-slate-500 mt-1 font-medium">Theo dõi thông tin và lương thưởng toàn đại lý</p>
                            </div>
                            <button 
                                onClick={() => setIsAddOpen(true)}
                                className="flex items-center justify-center gap-2 bg-navy-900 hover:bg-navy-800 text-white px-5 py-2.5 rounded-xl transition-all shadow-lg hover:shadow-xl active:scale-95 font-medium"
                            >
                                <IconPlus /> Thêm Nhân Viên
                            </button>
                        </header>

                        <div className="grid grid-cols-1 md:grid-cols-3 gap-6 mb-10">
                            <StatCard 
                                title="Tổng Nhân Viên" 
                                value={totalEmployees} 
                                icon={<IconUsers className="w-7 h-7 text-teal-600" />}
                                colorClass="bg-teal-100/50"
                                subtext="Toàn bộ hệ thống"
                            />
                            <StatCard 
                                title="Lương Trung Bình" 
                                value={formatVND(avgSalary)} 
                                icon={<IconMoney className="w-7 h-7 text-indigo-600" />}
                                colorClass="bg-indigo-100/50"
                                subtext="Chi trả mỗi tháng"
                            />
                            <StatCard 
                                title="Lương CB Cao Nhất" 
                                value={highestBase ? formatVND(highestBase.baseSalary) : '0 ₫'} 
                                icon={<IconStar className="w-7 h-7 text-amber-600" />}
                                colorClass="bg-amber-100/50"
                                subtext={highestBase ? `Nhân viên: ${highestBase.name}` : ''}
                            />
                        </div>

                        <div className="glass-panel rounded-2xl overflow-hidden shadow-sm border border-slate-200/60">
                            <div className="p-6 border-b border-slate-200/60 bg-white/60 flex flex-col md:flex-row justify-between items-center gap-4">
                                <h3 className="text-lg font-bold text-slate-800 flex items-center gap-2">
                                    <IconUsers className="w-5 h-5 text-teal-600" />
                                    Danh sách nhân sự
                                </h3>
                                <div className="relative w-full md:w-80">
                                    <div className="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400">
                                        <IconSearch />
                                    </div>
                                    <input 
                                        type="text" 
                                        placeholder="Tìm kiếm theo Mã hoặc Tên..." 
                                        value={search}
                                        onChange={(e) => setSearch(e.target.value)}
                                        className="w-full pl-11 pr-4 py-2.5 bg-white border border-slate-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-teal-500 focus:border-transparent transition-all shadow-sm font-medium text-slate-700 placeholder:text-slate-400"
                                    />
                                </div>
                            </div>
                            
                            <div className="overflow-x-auto">
                                <table className="w-full text-left border-collapse">
                                    <thead>
                                        <tr className="bg-slate-50/80 border-b border-slate-200/80">
                                            <th className="px-6 py-4 text-xs font-bold text-slate-500 uppercase tracking-wider">Mã NV</th>
                                            <th className="px-6 py-4 text-xs font-bold text-slate-500 uppercase tracking-wider">Họ Tên</th>
                                            <th className="px-6 py-4 text-xs font-bold text-slate-500 uppercase tracking-wider">Loại</th>
                                            <th className="px-6 py-4 text-xs font-bold text-slate-500 uppercase tracking-wider">Lương CB</th>
                                            <th className="px-6 py-4 text-xs font-bold text-slate-500 uppercase tracking-wider">Lương Tháng</th>
                                            <th className="px-6 py-4 text-xs font-bold text-slate-500 uppercase tracking-wider text-right">Hành động</th>
                                        </tr>
                                    </thead>
                                    <tbody className="divide-y divide-slate-100 bg-white/40">
                                        {filteredEmployees.length === 0 ? (
                                            <tr><td colSpan="6" className="px-6 py-12 text-center text-slate-500 font-medium">Không tìm thấy nhân viên nào</td></tr>
                                        ) : filteredEmployees.map(emp => (
                                            <tr key={emp.id} className="hover:bg-teal-50/30 transition-colors group">
                                                <td className="px-6 py-4 whitespace-nowrap font-bold text-slate-700">{emp.id}</td>
                                                <td className="px-6 py-4 whitespace-nowrap font-medium text-slate-800">{emp.name}</td>
                                                <td className="px-6 py-4 whitespace-nowrap">
                                                    <span className={`px-3 py-1 rounded-full text-xs font-bold shadow-sm inline-block
                                                        ${emp.type === 'office' ? 'bg-blue-100 text-blue-700 border border-blue-200/50' : 
                                                          emp.type === 'production' ? 'bg-orange-100 text-orange-700 border border-orange-200/50' : 
                                                          'bg-purple-100 text-purple-700 border border-purple-200/50'}`}>
                                                        {emp.getTypeLabel()}
                                                    </span>
                                                </td>
                                                <td className="px-6 py-4 whitespace-nowrap font-medium text-slate-500">{formatVND(emp.baseSalary)}</td>
                                                <td className="px-6 py-4 whitespace-nowrap font-bold text-teal-600 bg-teal-50/10">{formatVND(emp.calculateSalary())}</td>
                                                <td className="px-6 py-4 whitespace-nowrap text-right">
                                                    <button 
                                                        onClick={() => { setUpdateModal({ isOpen: true, emp }); setUpdateSalaryVal(emp.baseSalary); }}
                                                        className="inline-flex items-center gap-1.5 text-sm text-indigo-600 hover:text-indigo-800 font-bold px-3 py-1.5 rounded-lg hover:bg-indigo-50 transition-colors md:opacity-0 group-hover:opacity-100 focus:opacity-100"
                                                    >
                                                        <IconEdit /> Sửa LCB
                                                    </button>
                                                </td>
                                            </tr>
                                        ))}
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </main>

                    {isAddOpen && (
                        <div className="fixed inset-0 z-50 flex items-center justify-center p-4 bg-navy-900/40 backdrop-blur-sm animate-fade-in">
                            <div className="bg-white rounded-2xl shadow-2xl w-full max-w-md overflow-hidden flex flex-col max-h-[90vh] border border-slate-100">
                                <div className="p-5 border-b flex justify-between items-center bg-slate-50/80">
                                    <h3 className="text-xl font-bold text-slate-800">Thêm Nhân Viên Mới</h3>
                                    <button onClick={() => setIsAddOpen(false)} className="text-slate-400 hover:text-red-500 transition-colors bg-white rounded-full p-1 shadow-sm"><IconClose /></button>
                                </div>
                                <div className="p-6 overflow-y-auto">
                                    <form id="addForm" onSubmit={handleAddSubmit} className="space-y-5">
                                        <div>
                                            <label className="block text-sm font-bold text-slate-700 mb-1.5">Phân loại nhân sự</label>
                                            <div className="relative">
                                                <select 
                                                    value={addForm.type} 
                                                    onChange={e => setAddForm({...addForm, type: e.target.value})}
                                                    className="w-full px-4 py-3 bg-white border border-slate-300 rounded-xl focus:ring-2 focus:ring-teal-500 focus:border-teal-500 outline-none transition-all font-medium appearance-none shadow-sm"
                                                >
                                                    <option value="office">Nhân viên Văn phòng</option>
                                                    <option value="production">Nhân viên Sản xuất</option>
                                                    <option value="manager">Nhân viên Quản lý</option>
                                                </select>
                                                <div className="pointer-events-none absolute inset-y-0 right-0 flex items-center px-4 text-slate-500">
                                                    <svg className="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path strokeLinecap="round" strokeLinejoin="round" strokeWidth="2" d="M19 9l-7 7-7-7"></path></svg>
                                                </div>
                                            </div>
                                        </div>
                                        
                                        <div className="grid grid-cols-2 gap-4">
                                            <div>
                                                <label className="block text-sm font-bold text-slate-700 mb-1.5">Mã NV</label>
                                                <input required type="text" value={addForm.id} onChange={e => setAddForm({...addForm, id: e.target.value})} className="w-full px-4 py-3 bg-white border border-slate-300 rounded-xl focus:ring-2 focus:ring-teal-500 outline-none shadow-sm font-medium placeholder:font-normal placeholder:text-slate-300" placeholder="VD: NV004"/>
                                            </div>
                                            <div>
                                                <label className="block text-sm font-bold text-slate-700 mb-1.5">Họ Tên</label>
                                                <input required type="text" value={addForm.name} onChange={e => setAddForm({...addForm, name: e.target.value})} className="w-full px-4 py-3 bg-white border border-slate-300 rounded-xl focus:ring-2 focus:ring-teal-500 outline-none shadow-sm font-medium placeholder:font-normal placeholder:text-slate-300" placeholder="Tên NV..."/>
                                            </div>
                                        </div>
                                        
                                        <div>
                                            <label className="block text-sm font-bold text-slate-700 mb-1.5">Lương Cơ Bản (VNĐ)</label>
                                            <div className="relative">
                                                <div className="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none text-slate-400 font-bold">₫</div>
                                                <input required type="number" min="0" value={addForm.baseSalary} onChange={e => setAddForm({...addForm, baseSalary: e.target.value})} className="w-full pl-8 pr-4 py-3 bg-white border border-slate-300 rounded-xl focus:ring-2 focus:ring-teal-500 outline-none shadow-sm font-medium" placeholder="8000000"/>
                                            </div>
                                        </div>

                                        <div className="pt-2">
                                            {addForm.type === 'office' && (
                                                <div className="p-5 bg-blue-50/50 rounded-xl border border-blue-100 shadow-sm animate-fade-in">
                                                    <label className="block text-sm font-bold text-blue-900 mb-2">Số giờ làm việc (tháng)</label>
                                                    <input required type="number" min="0" value={extraFields.hours} onChange={e => setExtraFields({...extraFields, hours: e.target.value})} className="w-full px-4 py-3 bg-white border border-blue-200 rounded-xl focus:ring-2 focus:ring-blue-500 outline-none font-medium text-blue-900" placeholder="VD: 120"/>
                                                    <p className="text-xs text-blue-600 mt-2">Phụ cấp 5,000,000đ nếu > 100 giờ</p>
                                                </div>
                                            )}
                                            {addForm.type === 'production' && (
                                                <div className="p-5 bg-orange-50/50 rounded-xl border border-orange-100 shadow-sm animate-fade-in">
                                                    <label className="block text-sm font-bold text-orange-900 mb-2">Số sản phẩm</label>
                                                    <input required type="number" min="0" value={extraFields.products} onChange={e => setExtraFields({...extraFields, products: e.target.value})} className="w-full px-4 py-3 bg-white border border-orange-200 rounded-xl focus:ring-2 focus:ring-orange-500 outline-none font-medium text-orange-900" placeholder="VD: 160"/>
                                                    <p className="text-xs text-orange-600 mt-2">Thưởng 20% tổng lương nếu > 150 SP</p>
                                                </div>
                                            )}
                                            {addForm.type === 'manager' && (
                                                <div className="grid grid-cols-2 gap-4 p-5 bg-purple-50/50 rounded-xl border border-purple-100 shadow-sm animate-fade-in">
                                                    <div>
                                                        <label className="block text-sm font-bold text-purple-900 mb-2">Hệ số chức vụ</label>
                                                        <input required type="number" step="0.1" min="1" value={extraFields.roleFactor} onChange={e => setExtraFields({...extraFields, roleFactor: e.target.value})} className="w-full px-4 py-3 bg-white border border-purple-200 rounded-xl focus:ring-2 focus:ring-purple-500 outline-none font-medium text-purple-900" placeholder="VD: 1.5"/>
                                                    </div>
                                                    <div>
                                                        <label className="block text-sm font-bold text-purple-900 mb-2">Tiền thưởng</label>
                                                        <input required type="number" min="0" value={extraFields.bonus} onChange={e => setExtraFields({...extraFields, bonus: e.target.value})} className="w-full px-4 py-3 bg-white border border-purple-200 rounded-xl focus:ring-2 focus:ring-purple-500 outline-none font-medium text-purple-900" placeholder="VNĐ"/>
                                                    </div>
                                                </div>
                                            )}
                                        </div>
                                    </form>
                                </div>
                                <div className="p-5 border-t border-slate-100 bg-slate-50 flex justify-end gap-3">
                                    <button type="button" onClick={() => setIsAddOpen(false)} className="px-5 py-2.5 text-slate-600 font-bold hover:bg-slate-200 rounded-xl transition-colors">Hủy</button>
                                    <button type="submit" form="addForm" className="px-6 py-2.5 bg-teal-600 hover:bg-teal-700 text-white font-bold rounded-xl transition-colors shadow-lg hover:shadow-xl active:scale-95">Lưu Nhân Viên</button>
                                </div>
                            </div>
                        </div>
                    )}

                    {updateModal.isOpen && (
                        <div className="fixed inset-0 z-[60] flex items-center justify-center p-4 bg-navy-900/60 backdrop-blur-sm animate-fade-in">
                            <div className="bg-white rounded-2xl shadow-2xl w-full max-w-sm p-7 border border-slate-100">
                                <div className="flex items-center gap-3 mb-5">
                                    <div className="w-10 h-10 rounded-full bg-indigo-100 flex items-center justify-center text-indigo-600">
                                        <IconMoney />
                                    </div>
                                    <div>
                                        <h3 className="text-lg font-bold text-slate-800">Cập nhật LCB</h3>
                                        <p className="text-sm font-medium text-slate-500">NV: <span className="text-slate-700">{updateModal.emp?.name}</span></p>
                                    </div>
                                </div>
                                <form onSubmit={handleUpdateSalarySubmit}>
                                    <div className="mb-6">
                                        <label className="block text-sm font-bold text-slate-700 mb-2">Lương Cơ Bản Mới (VNĐ)</label>
                                        <div className="relative">
                                            <div className="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none text-slate-400 font-bold">₫</div>
                                            <input 
                                                type="number" min="0" required
                                                value={updateSalaryVal}
                                                onChange={e => setUpdateSalaryVal(e.target.value)}
                                                className="w-full pl-8 pr-4 py-3 bg-slate-50 border border-slate-300 rounded-xl focus:ring-2 focus:ring-indigo-500 outline-none font-bold text-slate-800 text-lg shadow-inner"
                                            />
                                        </div>
                                    </div>
                                    <div className="flex justify-end gap-3">
                                        <button type="button" onClick={() => setUpdateModal({isOpen: false, emp: null})} className="px-5 py-2.5 text-slate-600 font-bold hover:bg-slate-100 rounded-xl transition-colors">Hủy</button>
                                        <button type="submit" className="px-5 py-2.5 bg-indigo-600 hover:bg-indigo-700 text-white font-bold rounded-xl transition-colors shadow-lg active:scale-95">Cập nhật</button>
                                    </div>
                                </form>
                            </div>
                        </div>
                    )}
                </div>
            );
        };

        const root = ReactDOM.createRoot(document.getElementById('root'));
        root.render(<App />);
    </script>
</body>
</html>
